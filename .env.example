# Copy this file to .env and fill in real values. Never commit .env.

PORT=8000

# Key the admin endpoints require in the "x-admin-key" header.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(24))"
ADMIN_KEY=change-this-to-a-long-random-string

# Where the SQLite file lives. On a host with a persistent volume/disk this
# should point inside it, e.g. /data/victorlights.db
DB_PATH=./data/victorlights.db

# WhatsApp number customers order to (international format, no +, no spaces)
WHATSAPP_NUMBER=254712345678

# Comma-separated list of origins allowed to call the API.
# Set to your real domain in production, e.g. https://victorlights.co.ke
CORS_ORIGIN=*

# --- Optional: M-Pesa Daraja (STK Push) ---
# Leave blank to keep M-Pesa as "pay on delivery / manual till" only.
# See README.md "M-Pesa" section before enabling.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
